# vscode
.vscode

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# styles.css is generated from src/style/index.css by the build, so it is not
# tracked either. `pnpm dev` rewrites it unminified and used to leave a diff
# behind on every save.
styles.css

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store


# Rar Zip Files
*.rar
*.zip
*.7z
